{
  "entryFile": "src/app.ts",
  "authenticationModule": "./src/authentication.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": [
    "src/controllers/**/*.controller.ts",
    "src/features/**/*.controller.ts"
  ],
  "spec": {
    "outputDirectory": "src",
    "specVersion": 3,
    "basePath": "/",
    "schemes": ["http"],
    "securityDefinitions": {
      "firebase": { "type": "apiKey", "name": "Authorization", "in": "header" },
      "claims": { "type": "apiKey", "name": "Authorization", "in": "header" }
    }
  },
  "routes": {
    "routesDir": "src",
    "basePath": "/"
  }
}
