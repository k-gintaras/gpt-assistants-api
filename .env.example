DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=gpt_assistants
TEST_DB_NAME=gpt_assistants
NODE_ENV=production
OPENAI_API_KEY=
OPENAI_PROJECT_KEY=

# Firebase Admin SDK - set this to point to your service account JSON file
# File should be in project root (same folder as .env)
# IMPORTANT: Add the JSON file to .gitignore to prevent committing secrets!
GOOGLE_APPLICATION_CREDENTIALS=./ai-api-5c92d-firebase-adminsdk-fbsvc-2df8c90eaf.json
ROOT_ADMIN_UID=CHANGE_ME_ROOT_ADMIN_UID

# Development: Skip auth on localhost
# Set to 'true' only in development mode to test endpoints without Bearer token
LOCALHOST_AUTH_BYPASS=false